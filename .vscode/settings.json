{
    // Project layout (portable, safe to share).
    "java.project.sourcePaths": ["src"],
    "java.project.outputPath": "bin",
    "java.jdt.ls.vmargs": "-XX:+UseParallelGC -XX:GCTimeRatio=4 -XX:AdaptiveSizePolicyWeight=90 -Dsun.zip.disableMemoryMapping=true -Xmx4G -Xms100m -Xlog:disable",

    // This project runs on any JDK 8+ (see README), so no specific runtime is pinned here.
    // If VS Code can't auto-detect a JDK on your machine, point it at yours in your personal
    // User Settings (Ctrl+Shift+P -> "Preferences: Open User Settings (JSON)") instead of here,
    // so the path stays local to you and doesn't break the build for teammates:
    //
    // "java.jdt.ls.java.home": "<absolute path to your JDK>",
    // "java.configuration.runtimes": [
    //     { "name": "JavaSE-21", "path": "<absolute path to your JDK>", "default": true }
    // ]
}
